<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 通知変更・時刻予約・再起動の受信に使う権限。許可の確認と設定案内はKotlin側で行う。 -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />


    <!-- 起動準備、アプリ名、アイコン、基本テーマをアプリ全体へ適用する。 -->
    <application
        android:name=".app.BellApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Superkemotaro3">
        <activity android:name=".frontend.screens.HomeActivity" android:exported="false" />
        <!-- 旧ランチャー識別名をエイリアスとして維持し、新しいホーム画面へつなぐ。 -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".frontend.screens.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- 時刻編集時は、入力キーボードが表示された分だけ画面を縮める。 -->
        <activity
            android:name=".frontend.screens.LessonTimeEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- アプリ自身の時刻予約を受け取る。通知変更の判断はサービスへ渡す。 -->
        <receiver android:name=".backend.receiver.NotificationAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.example.super_kemo_taro3.DND_ON" />
                <action android:name="com.example.super_kemo_taro3.DND_OFF" />
            </intent-filter>
        </receiver>
        <!-- 再起動・アプリ更新後に、保存した選択枠から予約を作り直す入口。 -->
        <receiver
            android:name=".backend.receiver.AlarmRecoveryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- アプリ更新でReceiver名が変わった後も、保存された予定を復元する。 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity android:name=".frontend.screens.MenuActivity" android:exported="false" />
        <!-- Moodleのモバイル起動が kemotaro://token=... で戻す。ログイン開始時の照合に通ったトークンだけを保存する。 -->
        <activity
            android:name=".frontend.screens.MoodleImportActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kemotaro" />
            </intent-filter>
        </activity>
        <activity android:name=".frontend.screens.TimetableEditorActivity" android:exported="false" />
        <activity android:name=".frontend.screens.NotificationTestActivity" android:exported="false" />
    </application>
</manifest>
